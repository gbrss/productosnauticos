---

<section class="relative z-10 -mt-10 md:-mt-14">
  <div class="max-w-6xl mx-auto px-4">
    <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
      <div class="grid md:grid-cols-2 gap-0">
        <!-- Image -->
        <div class="relative h-56 md:h-auto md:min-h-[300px]">
          <img 
            src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?q=80&w=1000&auto=format&fit=crop" 
            alt="Claraboya náutica" 
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>

        <!-- Content -->
        <div class="p-8 md:p-10 flex flex-col justify-center">
          <h2 class="text-2xl md:text-3xl font-display font-bold text-navy-900 mb-4">
            Un mundo en regalos corporativos y decoración náutica
          </h2>
          <p class="text-navy-600 leading-relaxed mb-6">
            Productos Náuticos es una empresa familiar que nace por la pasión al Mar, 
            la navegación y los deportes náuticos y tiene como objetivo plasmar parte de esa pasión 
            con productos innovadores, exclusivos, personalizados y de alta calidad.
          </p>
          <div>
            <a href="/nosotros" class="btn-primary">
              SABER MÁS
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
