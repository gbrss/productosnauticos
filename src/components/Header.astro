---
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Catálogo', href: '/catalogo' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
  { label: 'Clientes', href: '/clientes', dropdown: true },
  { label: 'Ofertas!', href: '/ofertas' },
];
---

<!-- Top bar -->
<div class="bg-navy-950 text-white text-sm">
  <div class="max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-4">
      <a href="tel:+56232173438" class="flex items-center gap-1.5 hover:text-gold-400 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        +56 232 173 438
      </a>
      <a href="mailto:contacto@productosnauticos.cl" class="flex items-center gap-1.5 hover:text-gold-400 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        contacto@productosnauticos.cl
      </a>
    </div>
    <p class="text-xs md:text-sm text-navy-200">
      Para visitas a nuestro Showroom coordinar vía telefónica
    </p>
  </div>
</div>

<!-- Main header -->
<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-20 gap-4">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 flex items-center gap-3 group">
        <img src="/logo-icon.svg" alt="Productos Náuticos" class="h-12 w-auto group-hover:scale-105 transition-transform" />
        <div class="hidden sm:block">
          <span class="text-lg font-display font-bold text-navy-900 tracking-tight block leading-tight">Productos Náuticos</span>
          <p class="text-[10px] text-navy-500 leading-none">Regalos Corporativos y Decoración Náutica</p>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <a 
            href={item.href}
            class={`px-3 py-2 text-sm font-medium rounded-lg transition ${
              item.label === 'Inicio' 
                ? 'bg-navy-900 text-white' 
                : 'text-navy-700 hover:bg-navy-50 hover:text-navy-900'
            }`}
          >
            {item.label}
            {item.dropdown && (
              <svg class="inline w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            )}
          </a>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="flex items-center gap-3">
        <a href="/carrito" class="relative p-2 text-navy-700 hover:text-navy-900 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          <span class="absolute -top-0.5 -right-0.5 bg-navy-900 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center">0</span>
        </a>
        
        <div class="hidden md:block relative">
          <input 
            type="search" 
            placeholder="Buscar ..." 
            class="w-48 lg:w-56 pl-4 pr-10 py-2 text-sm border border-navy-200 rounded-full focus:outline-none focus:ring-2 focus:ring-navy-500 focus:border-transparent"
          />
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-navy-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-navy-700" aria-label="Menú">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-navy-100 bg-white">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navItems.map((item) => (
        <a href={item.href} class="px-3 py-2.5 text-sm font-medium text-navy-700 hover:bg-navy-50 rounded-lg">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
