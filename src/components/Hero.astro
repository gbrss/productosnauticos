---
// Hero section
---

<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <img 
      src="/header.png" 
      alt="Barcos en el mar" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-navy-950/60 via-navy-900/40 to-navy-950/70"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto py-20">
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-extrabold text-white tracking-tight mb-4 drop-shadow-lg">
      PRODUCTOS NÁUTICOS
    </h1>
    <p class="text-lg md:text-xl text-white/90 font-light mb-2">
      Trabajos exclusivos....Tu idea, tu diseño, tu imágen.
    </p>
    <!-- <p class="text-base md:text-lg text-white/80 mb-1">
      Regalos Náuticos para Amantes del Mar
    </p>
    <p class="text-sm md:text-base text-white/70 mb-8">
      Estilo, diseño y carácter marítimo
    </p>-->ñ
    <a href="/catalogo" class="btn-primary text-base md:text-lg px-10 py-4">
      VER PRODUCTOS
    </a>

    <!-- Product icons - now inside the flow, not absolute -->
    <div class="mt-12 flex justify-center gap-4 md:gap-6">
      <div class="bg-white/95 backdrop-blur rounded-xl p-3 shadow-xl">
        <div class="w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-amber-100 to-amber-200 rounded-lg flex items-center justify-center">
          <span class="text-2xl md:text-3xl"><img src="https://i0.wp.com/nautigift.cl/wp-content/uploads/2021/05/P-604.jpg?fit=1200%2C1200&ssl=1" class="w-full h-full object-cover" /></span>
        </div>
      </div>
      <div class="bg-white/95 backdrop-blur rounded-xl p-3 shadow-xl">
        <div class="w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-blue-100 to-blue-200 rounded-lg flex items-center justify-center">
          <span class="text-2xl md:text-3xl"><img src="https://i0.wp.com/nautigift.cl/wp-content/uploads/2023/03/reloj-claraboya-rosa-de-los-vientos2.png?fit=1200%2C1200&ssl=1" class="w-full h-full object-cover" /></span>
        </div>
      </div>
      <div class="bg-white/95 backdrop-blur rounded-xl p-3 shadow-xl">
        <div class="w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-lg flex items-center justify-center">
          <span class="text-2xl md:text-3xl"><img src="https://i0.wp.com/nautigift.cl/wp-content/uploads/2021/03/P-908.jpg?fit=300%2C300&ssl=1" class="w-full h-full object-cover" /></span></span>
        </div>
      </div>
      <div class="bg-white/95 backdrop-blur rounded-xl p-3 shadow-xl">
        <div class="w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-stone-100 to-stone-200 rounded-lg flex items-center justify-center">
          <span class="text-2xl md:text-3xl"><img src="https://i0.wp.com/nautigift.cl/wp-content/uploads/2021/03/B-453-B.jpg?fit=400%2C400&ssl=1" class="w-full h-full object-cover" /></span
        </div>
      </div>
    </div>
  </div>
</section>
