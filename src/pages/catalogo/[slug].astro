---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { categories } from '../../data/categories';
import { getProducts } from '../../data/products';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const products = getProducts(category.slug);
---

<Layout title={`${category.name} | Catálogo Productos Náuticos`} description={`Productos de la categoría ${category.name}. Regalos náuticos personalizados.`}>
  <Header />
  <main>
    <section class="relative h-40 md:h-52 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img src="/header.png" alt="" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-navy-950/60"></div>
      </div>
      <div class="relative z-10 text-center px-4">
        <a href="/catalogo" class="text-white/70 text-sm hover:text-white transition">← Catálogo</a>
        <h1 class="text-3xl md:text-4xl font-display font-bold text-white mt-2">{category.name}</h1>
        <p class="text-white/70 text-sm mt-1">{products.length} productos</p>
      </div>
    </section>

    <section class="bg-gray-100 -mt-4 relative z-10 pb-16">
      <div class="max-w-6xl mx-auto px-4">
        <div class="bg-white rounded-t-3xl shadow-lg px-4 sm:px-8 pt-10 pb-12">
          {products.length === 0 ? (
            <div class="text-center py-12">
              <img src={category.image} alt={category.name} class="w-28 h-28 object-contain mx-auto mb-6" />
              <p class="text-navy-600 mb-6">Próximamente productos en esta categoría. Contáctanos para cotizar.</p>
              <a
                href={`https://wa.me/56986381820?text=${encodeURIComponent(`Hola! Me interesa la categoría: ${category.name}`)}`}
                target="_blank"
                rel="noopener"
                class="btn-primary"
              >
                Consultar por WhatsApp
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
              {products.map((p) => (
                <article class="group flex flex-col items-center text-center">
                  <div class="w-full aspect-square bg-gray-50 rounded-xl overflow-hidden mb-3 flex items-center justify-center border border-navy-50 group-hover:shadow-md transition">
                    {p.image ? (
                      <img src={p.image} alt={p.name} class="w-full h-full object-contain p-2" loading="lazy" />
                    ) : (
                      <span class="text-4xl text-navy-200">⚓</span>
                    )}
                  </div>
                  {p.sku && <p class="text-xs font-semibold text-navy-900 tracking-wide">{p.sku}</p>}
                  <h3 class="text-xs md:text-sm text-navy-700 leading-snug mt-1 mb-2 min-h-[2.5rem]">{p.name}</h3>
                  {p.price && <p class="text-sm font-bold text-navy-900">{p.price}</p>}
                  <a
                    href={`https://wa.me/56986381820?text=${encodeURIComponent(`Hola! Me interesa: ${p.sku ? p.sku + ' - ' : ''}${p.name}${p.price ? ' (' + p.price + ')' : ''}`)}`}
                    target="_blank"
                    rel="noopener"
                    class="mt-2 text-xs text-green-700 hover:text-green-800 font-medium"
                  >
                    Consultar →
                  </a>
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
