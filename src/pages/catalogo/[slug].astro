---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { categories } from '../../data/categories';
import { getProducts } from '../../data/products';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const products = getProducts(category.slug);
---

<Layout title={`${category.name} | Catálogo Productos Náuticos`} description={`Productos de la categoría ${category.name}. Regalos náuticos personalizados.`}>
  <Header />
  <main>
    <section class="relative h-40 md:h-52 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img src="/header.png" alt="" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-navy-950/60"></div>
      </div>
      <div class="relative z-10 text-center px-4">
        <a href="/catalogo" class="text-white/70 text-sm hover:text-white transition">← Catálogo</a>
        <h1 class="text-3xl md:text-4xl font-display font-bold text-white mt-2">{category.name}</h1>
        <p class="text-white/70 text-sm mt-1">{products.length} productos</p>
      </div>
    </section>

    <section class="bg-gray-100 -mt-4 relative z-10 pb-16">
      <div class="max-w-6xl mx-auto px-4">
        <div class="bg-white rounded-t-3xl shadow-lg px-4 sm:px-8 pt-10 pb-12">
          {products.length === 0 ? (
            <div class="text-center py-12">
              <img src={category.image} alt={category.name} class="w-28 h-28 object-contain mx-auto mb-6" />
              <p class="text-navy-600 mb-6">Próximamente productos en esta categoría. Contáctanos para cotizar.</p>
              <a
                href={`https://wa.me/56986381820?text=${encodeURIComponent(`Hola! Me interesa la categoría: ${category.name}`)}`}
                target="_blank"
                rel="noopener"
                class="btn-primary"
              >
                Consultar por WhatsApp
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
              {products.map((p) => (
                <a href={`/producto/${p.slug}`} class="group flex flex-col items-center text-center">
                  <div data-zoom class="w-full aspect-square bg-gray-50 rounded-xl overflow-hidden mb-3 flex items-center justify-center border border-navy-50 group-hover:shadow-md transition cursor-zoom-in">
                    {p.image ? (
                      <img src={p.image} alt={p.name} class="w-full h-full object-contain p-2 transition-transform duration-200 ease-out select-none" style="-webkit-touch-callout:none" draggable="false" loading="lazy" />
                    ) : (
                      <span class="text-4xl text-navy-200">⚓</span>
                    )}
                  </div>
                  {p.sku && <p class="text-xs font-semibold text-navy-900 tracking-wide">{p.sku}</p>}
                  <h3 class="text-xs md:text-sm text-navy-700 leading-snug mt-1 mb-1 min-h-[2.5rem] group-hover:text-navy-950">{p.name}</h3>
                  {p.description && (
                    <p class="text-[10px] md:text-xs text-navy-500 leading-snug mb-2 line-clamp-2">{p.description}</p>
                  )}
                  {p.price && <p class="text-sm font-bold text-navy-900">{p.price}</p>}
                  <span class="mt-2 text-xs text-navy-600 group-hover:text-navy-900 font-medium">Ver ficha →</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
  <script is:inline>
    // Zoom en las fotos de producto: con el mouse sigue al cursor; en pantallas
    // táctiles se activa manteniendo el dedo apretado (así no molesta al hacer
    // scroll ni al tocar para abrir la ficha).
    (function () {
      var ZOOM = 2.2, HOLD_MS = 300, MOVE_TOL = 8;
      document.querySelectorAll('[data-zoom]').forEach(function (box) {
        var img = box.querySelector('img');
        if (!img) return;
        var link = box.closest('a');

        function zoomAt(x, y) {
          var r = box.getBoundingClientRect();
          var px = Math.max(0, Math.min(100, ((x - r.left) / r.width) * 100));
          var py = Math.max(0, Math.min(100, ((y - r.top) / r.height) * 100));
          img.style.transformOrigin = px + '% ' + py + '%';
          img.style.transform = 'scale(' + ZOOM + ')';
        }
        function reset() {
          img.style.transform = '';
          img.style.transformOrigin = '';
        }

        // Mouse / lápiz
        function onPointer(e) {
          if (e.pointerType === 'touch') return;
          zoomAt(e.clientX, e.clientY);
        }
        box.addEventListener('pointerenter', onPointer);
        box.addEventListener('pointermove', onPointer);
        box.addEventListener('pointerleave', function (e) {
          if (e.pointerType !== 'touch') reset();
        });

        // Táctil: mantener apretado para hacer zoom y arrastrar para mover
        var timer = null, active = false, sx = 0, sy = 0, suppressClick = false;
        box.addEventListener('touchstart', function (e) {
          var t = e.touches[0];
          sx = t.clientX; sy = t.clientY; active = false;
          clearTimeout(timer);
          timer = setTimeout(function () { active = true; zoomAt(sx, sy); }, HOLD_MS);
        }, { passive: true });
        box.addEventListener('touchmove', function (e) {
          var t = e.touches[0];
          if (active) {
            e.preventDefault();
            zoomAt(t.clientX, t.clientY);
          } else if (Math.abs(t.clientX - sx) > MOVE_TOL || Math.abs(t.clientY - sy) > MOVE_TOL) {
            clearTimeout(timer);
          }
        }, { passive: false });
        function endTouch(e) {
          clearTimeout(timer);
          if (active) {
            if (e.cancelable) e.preventDefault();
            reset();
            suppressClick = true;
            setTimeout(function () { suppressClick = false; }, 400);
          }
          active = false;
        }
        box.addEventListener('touchend', endTouch);
        box.addEventListener('touchcancel', endTouch);
        box.addEventListener('contextmenu', function (e) {
          if (active || suppressClick) e.preventDefault();
        });
        if (link) {
          link.addEventListener('click', function (e) {
            if (suppressClick) e.preventDefault();
          });
        }
      });
    })();
  </script>
</Layout>
