---
import Layout from '../../../layouts/Layout.astro';
import { subcategoriasEscudos } from '../../../data/escudos';

export function getStaticPaths() {
  return subcategoriasEscudos.map(cat => ({
    params: { subcategoria: cat.slug },
    props: { cat }
  }));
}
const { cat } = Astro.props;
---
<Layout title={`${cat.nombre} | Productos Náuticos`}>
  <section class="relative bg-cover bg-center py-16" style="background-image: url('/images/fondo-catalogo.jpg')">
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative container mx-auto px-6 text-center text-white">
      <a href="/catalogo/escudos/" class="text-sm opacity-80">← Escudos</a>
      <h1 class="text-4xl font-bold mt-2">{cat.nombre}</h1>
      <p class="mt-2 opacity-90">{cat.productos.length} productos</p>
    </div>
  </section>

  <section class="container mx-auto px-6 py-10">
    <div class="grid grid-cols-2 gap-6">
      {cat.productos.map((p: any) => (
        <div class="border rounded-xl p-4 text-center">
          <img src={p.imagen} class="w-full h-48 object-contain mb-3" />
          <h3 class="font-bold text-sm">{p.sku}</h3>
          <p class="text-xs">{p.nombre}</p>
          <p class="font-bold mt-2">${p.precio}</p>
          <a href="#" class="text-sm text-blue-900">Ver ficha →</a>
        </div>
      ))}
    </div>
  </section>
</Layout>
