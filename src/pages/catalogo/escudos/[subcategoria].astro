---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import { subcategoriasEscudos } from '../../../data/escudos';

export function getStaticPaths() {
  return subcategoriasEscudos.map(cat => ({
    params: { subcategoria: cat.slug },
    props: { cat }
  }));
}
const { cat } = Astro.props;
const matriz = cat.matriz ?? [];
---
<style>
 .matriz-table { border-collapse: collapse; width: 100%; table-layout: auto; }
 .matriz-table th,.matriz-table td { border: 1.2px solid #000!important; }
</style>

<Layout title={`${cat.nombre} | Productos Náuticos`} description={cat.descripcion}>
  <Header />
  <main>
    <section class="relative h-56 md:h-72 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0">
        <img src="/header.png" alt={cat.nombre} class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-navy-950/55"></div>
      </div>
      <div class="relative z-10 flex flex-col items-center text-center px-4">
        <a href="/catalogo/escudos/" class="text-white/80 text-sm hover:underline mb-2">← Escudos</a>
        <h1 class="text-3xl md:text-5xl font-display font-extrabold text-white tracking-wide drop-shadow-lg">{cat.nombre}</h1>
        <p class="text-white/70 text-xs mt-2">{cat.medida} • {cat.count} productos</p>
      </div>
    </section>

    <section class="bg-gray-100 -mt-6 relative z-10 pb-20">
      <div class="max-w-7xl mx-auto px-4">
        <div class="bg-white rounded-t-3xl shadow-lg px-2 sm:px-8 pt-10 pb-16">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 max-w-4xl mx-auto">
            {cat.productos.map((p:any) => (
              <div class="flex flex-col items-center text-center p-2">
                <img src={p.imagen} alt={p.nombre} class="w-24 h-32 object-contain mb-3" />
                <h3 class="font-bold text-navy-900 text-">{p.nombre}</h3>
                {p.precio && <p class="font-extrabold text-navy-900 mt-1 text-">${p.precio}</p>}
                <p class="text- text-gray-600 mt-1 leading-tight max-w-">{p.descripcion}<br/>Contáctenos para hacer su pedido.</p>
              </div>
            ))}
          </div>

          {matriz.length > 0 && (
          <div id="matriz-container">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-3">
              <h3 class="font-bold text-navy-900 text-">Reparticiones disponibles - Matriz ({matriz.length} unidades)</h3>
              <div class="flex gap-2 items-center">
                <input id="searchMatriz" type="text" placeholder="Filtrar..." class="border border-black rounded-md px-2 py-1 text- w-56" />
                <span id="counter" class="text- text-gray-500"></span>
              </div>
            </div>

            <div class="overflow-x-auto border border-black">
              <table class="matriz-table">
                <thead>
                  <tr class="bg-[#0a1931] text-white">
                    <th class="text- font-semibold py-1.5 px-1 uppercase whitespace-nowrap min-w-">SKU</th>
                    <th class="text- font-semibold py-1.5 px-1 uppercase min-w-">INSTITUCIÓN</th>
                    <th class="text- font-semibold py-1.5 px-1 uppercase min-w-">REPARTICIÓN</th>
                    <th class="text- font-semibold py-1.5 px-1 uppercase min-w-">UNIDADES</th>
                    <th class="text- font-semibold py-1.5 px-1 uppercase min-w-">MEDIDAS</th>
                    <th class="text- font-semibold py-1.5 px-1 uppercase min-w-">FECHA DE CONFECCIÓN</th>
                    <th class="text- font-semibold py-1.5 px-1 uppercase min-w-">CALZO</th>
                    <th class="text- font-semibold py-1.5 px-1 uppercase min-w-">OBSERVACIONES</th>
                  </tr>
                </thead>
                <tbody id="matriz-body"></tbody>
              </table>
            </div>

            <div class="flex items-center justify-between mt-3">
              <button id="prevBtn" class="px-2 py-1 text- border border-black rounded">← Anterior</button>
              <div class="flex gap-1" id="pagination"></div>
              <button id="nextBtn" class="px-2 py-1 text- border border-black rounded">Siguiente →</button>
            </div>
          </div>
          )}

        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />

  {matriz.length > 0 && (<script define:vars={{ matriz }}>
    let filtered = [...matriz];
    let currentPage = 1;
    const perPage = 25;
    const body = document.getElementById('matriz-body');
    const pagination = document.getElementById('pagination');
    const search = document.getElementById('searchMatriz');
    const counter = document.getElementById('counter');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    function render() {
      const start = (currentPage - 1) * perPage;
      const pageData = filtered.slice(start, start + perPage);
      body.innerHTML = pageData.map(r => `
        <tr>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:center; white-space:nowrap; text-transform:uppercase; line-height:1.1;">${r.sku||''}</td>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:center; text-transform:uppercase; line-height:1.1;">${r.institucion||''}</td>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:center; text-transform:uppercase; line-height:1.1;">${r.reparticion||''}</td>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:left; text-transform:uppercase; line-height:1.1;">${r.unidad||r.unidades||''}</td>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:center; line-height:1.1;">${r.medidas||'-'}</td>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:center; line-height:1.1;">${r.fecha||'-'}</td>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:center; line-height:1.1;">${r.calzo||''}</td>
          <td style="border:1.2px solid #000; font-size:12px; padding:3px 4px; text-align:center; line-height:1.1;">${r.obs||''}</td>
        </tr>
      `).join('');
      const totalPages = Math.ceil(filtered.length / perPage) || 1;
      counter.textContent = `${filtered.length} resultados - Pág ${currentPage}/${totalPages}`;
      pagination.innerHTML = '';
      let s = Math.max(1, currentPage-2), e = Math.min(totalPages, s+4);
      for(let i=s;i<=e;i++){
        const b=document.createElement('button');
        b.textContent=i;
        b.className=`px-2 py-0.5 text- border border-black ${i===currentPage?'bg-[#0a1931] text-white':'bg-white'}`;
        b.onclick=()=>{currentPage=i; render();};
        pagination.appendChild(b);
      }
      prevBtn.disabled=currentPage===1;
      nextBtn.disabled=currentPage===totalPages;
    }
    search.addEventListener('input', e=>{
      const q=e.target.value.toLowerCase();
      filtered=matriz.filter(r=>(r.sku||'').toLowerCase().includes(q)||(r.institucion||'').toLowerCase().includes(q)||(r.reparticion||'').toLowerCase().includes(q)||(r.unidad||r.unidades||'').toLowerCase().includes(q));
      currentPage=1; render();
    });
    prevBtn.onclick=()=>{if(currentPage>1){currentPage--; render();}};
    nextBtn.onclick=()=>{if(currentPage<Math.ceil(filtered.length/perPage)){currentPage++; render();}};
    render();
  </script>)}
</Layout>