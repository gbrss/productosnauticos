---
import Layout from '../../../layouts/Layout.astro';
import { subcategoriasEscudos } from '../../../data/escudos';
---
<Layout title="Escudos | Catálogo Productos Náuticos">
  <!-- ESTE HEADER es el que te falta, igual a escafandras -->
  <section class="relative bg-cover bg-center py-16" style="background-image: url('/images/fondo-catalogo.jpg')">
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative container mx-auto px-6 text-center text-white">
      <a href="/catalogo/" class="text-sm opacity-80">← Catálogo</a>
      <h1 class="text-4xl md:text-5xl font-bold mt-2">Escudos</h1>
      <p class="mt-2 opacity-90">{subcategoriasEscudos.length} categorías</p>
      <p class="mt-4 text-sm max-w-2xl mx-auto">Estimados clientes: Para pedidos de escudos enviar email a contacto@comercialayd.cl</p>
    </div>
  </section>

  <!-- Grid estilo Nautigift con círculos -->
  <section class="container mx-auto px-6 py-12 bg-gradient-to-b from-[#9aa4b8] to-[#e5e7eb]">
    <div class="max-w-md mx-auto flex flex-col gap-10">
      {subcategoriasEscudos.map((cat) => (
        <a href={`/catalogo/escudos/${cat.slug}/`} class="flex flex-col items-center group">
          <div class="w-64 h-64 rounded-full bg-white overflow-hidden shadow-lg flex items-center justify-center group-hover:scale-105 transition">
            <img src={cat.imagen} alt={cat.nombre} class="w-full h-full object-contain p-2" />
          </div>
          <h2 class="mt-4 font-semibold text-[#1a2e4b] italic text-lg">{cat.nombre}</h2>
        </a>
      ))}
    </div>
  </section>
</Layout>
